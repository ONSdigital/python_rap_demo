# .gitignore for python_rap_demo RAP project
# This file tells Git which files and folders to ignore (not track in version control).
# Use it to keep your repository clean and avoid sharing sensitive, temporary, or auto-generated files.

# Data and config (if you want to keep local or sensitive files out of Git)
# Uncomment the next lines if you want to ignore local data/config
# Ignore all files in the data folder (e.g., health_data.csv)
# data/
# Ignore all files in the config folder (e.g., user_config.yaml)
# config/

# Build and distribution folders (if packaging)
# Ignore build output folder
build/
# Ignore distribution output folder
dist/
# Ignore Python package metadata folders
*.egg-info/

# Python cache and bytecode
# Ignore pytest cache folder (e.g., tests/.pytest_cache/)
.pytest_cache/
# Ignore generic cache files/folders
.cache
# Ignore all Python cache folders (e.g., src/__pycache__/)
__pycache__/
# Ignore Python bytecode files (e.g., main.pyc, utils.pyo)
*.py[cod]

# Environments
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

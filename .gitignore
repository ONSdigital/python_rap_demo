# .gitignore for python_rap_demo RAP project
# This file tells Git which files and folders to ignore (not track in version control).
# Use it to keep your repository clean and avoid sharing sensitive, temporary, or auto-generated files.

# Data and config (if you want to keep local or sensitive files out of Git)
# Uncomment the next lines if you want to ignore local data/config
# data/             # Would ignore all files in the data folder (e.g., health_data.csv)
# config/           # Would ignore all files in the config folder (e.g., user_config.yaml)

# Test and coverage outputs
.pytest_cache/      # Ignore pytest cache folder (e.g., tests/.pytest_cache/)
.cache              # Ignore generic cache files/folders

# Build and distribution folders (if packaging)
build/              # Ignore build output folder
dist/               # Ignore distribution output folder
*.egg-info/         # Ignore Python package metadata folders

# Python cache and bytecode
__pycache__/        # Ignore all Python cache folders (e.g., src/__pycache__/)
*.py[cod]           # Ignore Python bytecode files (e.g., main.pyc, utils.pyo)

# Environments
# Ignore virtual environment folders. Below is a list of a few that are used, but custom named environments
# can also be added if needed.
.env
.envrc
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
